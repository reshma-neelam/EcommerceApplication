# Copy this file to .env and adjust values for your machine.
# .env is git-ignored and must never contain real secrets committed to the repo.

# --- MySQL (used by compose.deps.yaml and the application local/docker profiles) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=product_catalog_db
DB_USERNAME=root
DB_PASSWORD=root

# --- Kafka (single-node KRaft broker in compose.deps.yaml) ---
KAFKA_PORT=9092

# --- Spring ---
# Active profile for the running application: local | docker | test
SPRING_PROFILES_ACTIVE=local

# --- NotificationService ---
SERVER_PORT=8084
NOTIFICATION_KAFKA_CONSUMER_ENABLED=true
NOTIFICATION_MAIL_ENABLED=false
NOTIFICATION_MAIL_FROM=no-reply@ecommerce.local
# Only needed when NOTIFICATION_MAIL_ENABLED=true:
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
